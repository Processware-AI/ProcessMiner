# 복사해서 .env 로 쓴다. 값은 로컬 개발용 기본값이다(docker-compose.yml 과 맞춰져 있다).

# API 가 쓰는 접속(슈퍼유저가 아닌 역할 — 회사 간 격리가 적용된다)
PM_DATABASE_URL=postgresql+psycopg://pm_app:pm_app@localhost:55432/processminer
# 마이그레이션·참조 데이터 적재용 접속(소유자 역할)
PM_MIGRATION_DATABASE_URL=postgresql+psycopg://pm_owner:pm_owner@localhost:55432/processminer

PM_WEB_BASE_URL=http://localhost:3000
# true 면 로그인 링크를 메일로 보내는 대신 화면과 로그에 노출한다. 운영에서는 반드시 false.
PM_AUTH_DEV_ECHO=true
# HTTPS 로 서비스할 때 true
PM_COOKIE_SECURE=false

# 요건 도출·문서 생성에 쓰는 Anthropic API 키. 비우면 SDK 의 기본 인증(환경 변수 ANTHROPIC_API_KEY,
# 로그인 프로필)을 쓴다. 이 값은 git 에 올리지 않는다.
PM_ANTHROPIC_API_KEY=
# PM_LLM_MODEL=claude-opus-5-5
# PM_LLM_CONCURRENCY=4
