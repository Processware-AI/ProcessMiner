# ==========================================
# macOS
# ==========================================
.DS_Store
._*
**/._*
.Spotlight-V100
.Trashes

# ==========================================
# 고객 입력자료 (저작권·기밀)
# 실데이터는 제외, 구조·README 만 버전 관리
# ==========================================

# sources/ — ingest 소스 파일 (PDF·DOCX 등, 저작권/기밀)
/sources/**
!/sources/
!/sources/README.md

# inputs/ — ingest 출력 패키지 (YAML·MD·py 만, 바이너리 금지)
/inputs/**
!/inputs/
!/inputs/README.md
!/inputs/*/
!/inputs/*/README.md
# 카테고리 직속 YAML·MD (예: 06_목표흐름/business_flow.yaml, 06_목표흐름/business_flow.md)
!/inputs/*/*.yaml
!/inputs/*/*.md
!/inputs/*/*/
!/inputs/*/*/*.yaml
!/inputs/*/*/*.md
# level-3 subdirs (_d1_batch/, qa/, ...) 안의 YAML·MD·py·tmp 도 허용 (audit evidence)
!/inputs/*/*/*/
!/inputs/*/*/*/*.yaml
!/inputs/*/*/*/*.md
!/inputs/*/*/*/*.py
!/inputs/*/*/*/*.tmp

# macOS metadata 재제외 (위 negation 규칙으로 다시 포함되지 않도록 마지막에 명시)
inputs/**/._*
inputs/**/.__*

# ==========================================
# subproducts/ — 본 repo 에서 제거됨 (2026-05-13)
# 모든 파생 프로덕트는 별도 repo 로 분리되어 운영.
# ==========================================
# (관련 패턴 정리 완료. 향후 메인 repo 안에 micro-product 가 필요해지면 재도입.)

# 02_적용요건 하위 실데이터 제외 (README만 추적)
!/vault/02_적용요건/
!/vault/02_적용요건/README.md

# ==========================================
# 파이프라인 실행 상태 (인스턴스별)
# ==========================================
.claude/states/*.yaml
.claude/states/*.db
.claude/states/*.log
vault/02_적용요건/**/99_QA리포트_*.md

# ==========================================
# Obsidian 워크스페이스 (개인 환경)
# ==========================================
.obsidian/workspace*
.obsidian/cache/
.obsidian/appearance.json
.obsidian/hotkeys.json

# ==========================================
# 환경·로그·임시
# ==========================================
*.log
*.tmp
.env
.env.local
.env.*.local
*.swp
*.swo

# ==========================================
# Claude Code 세션 캐시 (로컬만)
# ==========================================
.claude/sessions/
.claude/cache/
# ingest 임시 작업 폴더 (sources/ 에서 재생성 가능, 바이너리 포함 가능)
.claude/runs/ingest_*

# ==========================================
# 차원 2 (Do) 실행 캐시 — 재생성 가능
# `.claude/runs/` 는 감사 증적이므로 추적
# ==========================================
vault/05_WI_업무지침/.cache/

# ==========================================
# 의존성·빌드 (향후 프레임워크화 대비)
# ==========================================
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.egg-info/

# ==========================================
# processmine 런타임 데이터
# ==========================================
processmine.db
*.db

# ==========================================
# 웹 플랫폼 (apps/)
# ==========================================
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
apps/api/.env
apps/web/e2e/screenshots/
apps/web/test-results/
apps/web/playwright-report/

# 업로드한 원문 파일(로컬 보관소)
/var/
